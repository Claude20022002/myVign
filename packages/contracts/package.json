{
  "name": "@myvign/contracts",
  "version": "1.4.0",
  "private": true,
  "description": "Contrat d'API myVign : schémas Zod partagés (front, API, mobile), registre des routes, client typé, serveur simulé.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
